<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>排球「有球必 in」差異化評量系統 (v3 整合版)</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Google Fonts: Noto Sans TC & Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@600;800;900&family=Noto+Sans+TC:wght@400;500;700;900&display=swap" rel="stylesheet">
  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Noto Sans TC"', '"Inter"', 'sans-serif'],
            num: ['"Inter"', 'sans-serif'],
          },
          colors: {
            court: {
              navy: '#1E3A8A',
              deep: '#0F172A',
              yellow: '#FACC15',
              amber: '#F59E0B',
              green: '#10B981',
              surface: '#F8FAFC'
            }
          }
        }
      }
    }
  </script>
  <style>
    body {
      background-color: #F8FAFC;
      -webkit-tap-highlight-color: transparent;
    }
    .touch-btn {
      user-select: none;
      -webkit-user-select: none;
      transition: transform 0.08s ease, background-color 0.15s ease, border-color 0.15s ease, opacity 0.25s ease;
    }
    .touch-btn:active {
      transform: scale(0.96);
    }
    /* SVG 角色高亮與淡化過渡效果 */
    .svg-role-group {
      transition: opacity 0.3s ease, filter 0.3s ease;
    }
    .svg-dimmed {
      opacity: 0.22;
    }
    .svg-highlighted {
      opacity: 1;
      filter: drop-shadow(0 0 6px rgba(245, 158, 11, 0.75));
    }
    /* 拋物線流動動畫 */
    @keyframes dashFlow {
      to {
        stroke-dashoffset: -24;
      }
    }
    .animate-flight {
      stroke-dasharray: 6 6;
      animation: dashFlow 1s linear infinite;
    }
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-thumb {
      background: #CBD5E1;
      border-radius: 9999px;
    }
  </style>
</head>
<body class="text-slate-800 pb-28">

  <!-- 全域訊息提示框 (取代 alert) -->
  <div id="toast-container" class="fixed top-4 left-1/2 -translate-x-1/2 z-50 flex flex-col gap-2 w-11/12 max-w-md pointer-events-none"></div>

  <!-- 頂部品牌標題與雙分頁導覽列 -->
  <header class="bg-court-navy text-white shadow-md sticky top-0 z-40">
    <div class="max-w-2xl mx-auto px-4 pt-3.5 pb-3">
      <div class="flex items-center justify-between gap-2 mb-3">
        <div class="flex items-center gap-2.5">
          <div class="w-10 h-10 rounded-2xl bg-court-yellow text-court-deep flex items-center justify-center text-xl shadow-sm shrink-0">
            <i class="fa-solid fa-volleyball"></i>
          </div>
          <div>
            <div class="flex items-center gap-1.5">
              <span class="text-[10px] font-black tracking-wider bg-white/15 text-court-yellow px-2 py-0.5 rounded-full">大一體育 • QPE 差異化評量</span>
              <span class="text-[11px] text-blue-200 hidden sm:inline">轉換期</span>
            </div>
            <h1 class="text-base sm:text-lg font-black tracking-tight text-white">排球「有球必 in」評量系統 v3</h1>
          </div>
        </div>

        <!-- Google Sheet 連線狀態指示膠囊 -->
        <button type="button" onclick="openGasFromHeader()"
          class="touch-btn flex items-center gap-1.5 bg-white/10 hover:bg-white/20 border border-white/20 px-2.5 py-1.5 rounded-xl text-xs font-bold text-white shrink-0">
          <span id="header-gas-dot" class="w-2 h-2 rounded-full bg-rose-400 animate-pulse"></span>
          <span id="header-gas-text">試算表未設定</span>
        </button>
      </div>

      <!-- 無縫切換雙分頁標籤 (Tab) -->
      <div class="grid grid-cols-2 gap-1.5 bg-blue-950/60 p-1 rounded-2xl border border-blue-700/50">
        <button type="button" onclick="switchMainTab('guide')" id="main-tab-guide"
          class="touch-btn py-2.5 px-3 rounded-xl text-xs sm:text-sm font-black flex items-center justify-center gap-1.5 bg-court-yellow text-court-deep shadow">
          <i class="fa-solid fa-map-location-dot"></i>
          <span>① 活動操作方式</span>
        </button>
        <button type="button" onclick="switchMainTab('form')" id="main-tab-form"
          class="touch-btn py-2.5 px-3 rounded-xl text-xs sm:text-sm font-black flex items-center justify-center gap-1.5 text-blue-100 hover:bg-white/10">
          <i class="fa-solid fa-clipboard-list"></i>
          <span>② 測驗評量表單</span>
        </button>
      </div>
    </div>
  </header>

  <!-- ===================================================================== -->
  <!-- 分頁 1：① 活動操作方式                                                   -->
  <!-- ===================================================================== -->
  <div id="view-guide" class="max-w-2xl mx-auto px-4 pt-4 space-y-5">

    <!-- 活動目標卡片 -->
    <section class="bg-gradient-to-br from-court-navy to-blue-800 text-white rounded-3xl p-5 shadow-md">
      <div class="inline-flex items-center gap-1.5 bg-court-yellow/20 border border-court-yellow/40 text-court-yellow text-xs font-bold px-3 py-1 rounded-full mb-2">
        <i class="fa-solid fa-bullseye"></i>
        <span>接發球／救球（發展期）- 4 • 活動目標</span>
      </div>
      <p class="text-sm sm:text-base text-blue-50 leading-relaxed font-medium">
        能在發球—接發球循環練習中根據同儕的觀察紀錄與回饋修正自己的動作（判斷軌跡、迅速移動腳步及接發球之角度與力量控制），以將來球穩定地傳到有利舉球的位置。
      </p>
    </section>

    <!-- 互動式 SVG 半場三組站位示意圖 -->
    <section class="bg-white rounded-3xl shadow-sm border border-slate-200/90 p-4 sm:p-5">
      <div class="flex items-center justify-between mb-3">
        <h2 class="text-base sm:text-lg font-black text-court-deep flex items-center gap-2">
          <span class="w-2 h-5 bg-court-navy rounded-full"></span>
          半場三組站位與輪替圖解
        </h2>
        <span class="text-xs font-bold text-slate-400">點選角色看站位</span>
      </div>

      <!-- 角色切換互動按鈕列 -->
      <div class="grid grid-cols-4 gap-1.5 bg-slate-100 p-1.5 rounded-2xl mb-3">
        <button type="button" onclick="selectRole('all')" id="role-btn-all"
          class="touch-btn py-2 px-1 rounded-xl text-xs font-black bg-court-navy text-white shadow-sm">
          全部視角
        </button>
        <button type="button" onclick="selectRole('A')" id="role-btn-A"
          class="touch-btn py-2 px-1 rounded-xl text-xs font-bold text-slate-600 hover:bg-white/70">
          A組 發球
        </button>
        <button type="button" onclick="selectRole('B')" id="role-btn-B"
          class="touch-btn py-2 px-1 rounded-xl text-xs font-bold text-slate-600 hover:bg-white/70">
          B組 接發
        </button>
        <button type="button" onclick="selectRole('C')" id="role-btn-C"
          class="touch-btn py-2 px-1 rounded-xl text-xs font-bold text-slate-600 hover:bg-white/70">
          C組 觀察
        </button>
      </div>

      <!-- 動態角色任務提示條 -->
      <div class="bg-blue-50/70 border border-blue-200 rounded-2xl px-3.5 py-2.5 mb-3 text-xs sm:text-sm text-slate-700 flex items-center gap-2.5">
        <i class="fa-solid fa-people-arrows text-court-navy text-base shrink-0"></i>
        <span id="role-info-text">每半場分 <strong>A、B、C 三組</strong>輪替：A 發球、B 接球進目標區、C 場邊同步記錄與觀察。</span>
      </div>

      <!-- SVG 排球場示意圖 -->
      <div class="w-full bg-emerald-50/50 rounded-2xl border border-slate-200 p-2 overflow-hidden">
        <svg viewBox="0 0 620 330" class="w-full h-auto block" role="img" aria-label="排球有球必in半場三組站位圖">
          <defs>
            <marker id="arrow-dark" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
              <path d="M 0 1 L 10 5 L 0 9 z" fill="#0F172A" />
            </marker>
            <marker id="arrow-green" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse">
              <path d="M 0 1 L 10 5 L 0 9 z" fill="#059669" />
            </marker>
            <marker id="arrow-blue" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse">
              <path d="M 0 1 L 10 5 L 0 9 z" fill="#0284C7" />
            </marker>
          </defs>

          <!-- 球場外圍標籤：接 / 發 -->
          <text x="18" y="170" font-size="16" font-weight="900" fill="#475569" text-anchor="middle">接</text>
          <text x="602" y="170" font-size="16" font-weight="900" fill="#475569" text-anchor="middle">發</text>

          <!-- 左側半場 (接球側) -->
          <rect x="115" y="55" width="235" height="220" rx="6" fill="#BEF264" fill-opacity="0.55" stroke="#84CC16" stroke-width="2" />
          <!-- 右側半場 (發球側) -->
          <rect x="364" y="55" width="135" height="220" rx="6" fill="#BEF264" fill-opacity="0.55" stroke="#84CC16" stroke-width="2" />

          <!-- 中央球網 -->
          <line x1="357" y1="45" x2="357" y2="285" stroke="#0F172A" stroke-width="4" stroke-linecap="round" />
          <rect x="342" y="34" width="30" height="16" rx="4" fill="#0F172A" />
          <text x="357" y="45" font-size="10" font-weight="700" fill="#FFFFFF" text-anchor="middle">球網</text>

          <!-- 球場中線分隔 -->
          <line x1="115" y1="165" x2="499" y2="165" stroke="#15803D" stroke-width="2.5" stroke-dasharray="8 6" />

          <!-- 前排三米線虛線框與目標得分区 (舉球位) -->
          <g id="svg-target-zones" class="svg-role-group">
            <rect x="262" y="58" width="66" height="104" fill="none" stroke="#0284C7" stroke-width="2.5" stroke-dasharray="6 4" rx="4" />
            <rect x="280" y="72" width="30" height="76" rx="4" fill="#059669" />
            <rect x="262" y="168" width="66" height="104" fill="none" stroke="#059669" stroke-width="2.5" stroke-dasharray="6 4" rx="4" />
            <rect x="280" y="182" width="30" height="76" rx="4" fill="#0284C7" />
            <rect x="228" y="282" width="134" height="24" rx="12" fill="#0F172A" />
            <text x="295" y="298" font-size="11" font-weight="700" fill="#FACC15" text-anchor="middle">目標落地區（舉球位）</text>
          </g>

          <!-- B組：左側後場接發球者與排隊成員 -->
          <g id="svg-group-B" class="svg-role-group">
            <g transform="translate(52, 110)">
              <circle cx="0" cy="0" r="15" fill="#FFFFFF" stroke="#16A34A" stroke-width="2.5" />
              <circle cx="-5" cy="-3" r="1.8" fill="#16A34A" /><circle cx="5" cy="-3" r="1.8" fill="#16A34A" />
              <path d="M -5 4 Q 0 9 5 4" fill="none" stroke="#16A34A" stroke-width="2" stroke-linecap="round" />
            </g>
            <g transform="translate(90, 110)">
              <circle cx="0" cy="0" r="15" fill="#FFFFFF" stroke="#16A34A" stroke-width="2.5" />
              <circle cx="-5" cy="-3" r="1.8" fill="#16A34A" /><circle cx="5" cy="-3" r="1.8" fill="#16A34A" />
              <path d="M -5 4 Q 0 9 5 4" fill="none" stroke="#16A34A" stroke-width="2" stroke-linecap="round" />
            </g>
            <line x1="108" y1="110" x2="145" y2="110" stroke="#0F172A" stroke-width="2" stroke-dasharray="4 3" marker-end="url(#arrow-dark)" />
            <g transform="translate(168, 110)">
              <circle cx="0" cy="0" r="16" fill="#DCFCE7" stroke="#16A34A" stroke-width="3" />
              <circle cx="-5" cy="-3" r="2" fill="#15803D" /><circle cx="5" cy="-3" r="2" fill="#15803D" />
              <path d="M -6 4 Q 0 10 6 4" fill="none" stroke="#15803D" stroke-width="2" stroke-linecap="round" />
              <text x="-22" y="24" font-size="13" font-weight="900" fill="#15803D">B</text>
            </g>
            <path d="M 188 110 L 272 110" fill="none" stroke="#059669" stroke-width="2" stroke-dasharray="3 3" marker-end="url(#arrow-green)" />

            <g transform="translate(52, 220)">
              <circle cx="0" cy="0" r="15" fill="#FFFFFF" stroke="#0284C7" stroke-width="2.5" />
              <circle cx="-5" cy="-3" r="1.8" fill="#0284C7" /><circle cx="5" cy="-3" r="1.8" fill="#0284C7" />
              <path d="M -5 4 Q 0 9 5 4" fill="none" stroke="#0284C7" stroke-width="2" stroke-linecap="round" />
            </g>
            <g transform="translate(90, 220)">
              <circle cx="0" cy="0" r="15" fill="#FFFFFF" stroke="#0284C7" stroke-width="2.5" />
              <circle cx="-5" cy="-3" r="1.8" fill="#0284C7" /><circle cx="5" cy="-3" r="1.8" fill="#0284C7" />
              <path d="M -5 4 Q 0 9 5 4" fill="none" stroke="#0284C7" stroke-width="2" stroke-linecap="round" />
            </g>
            <line x1="108" y1="220" x2="145" y2="220" stroke="#0F172A" stroke-width="2" stroke-dasharray="4 3" marker-end="url(#arrow-dark)" />
            <g transform="translate(168, 220)">
              <circle cx="0" cy="0" r="16" fill="#E0F2FE" stroke="#0284C7" stroke-width="3" />
              <circle cx="-5" cy="-3" r="2" fill="#0369A1" /><circle cx="5" cy="-3" r="2" fill="#0369A1" />
              <path d="M -6 4 Q 0 10 6 4" fill="none" stroke="#0369A1" stroke-width="2" stroke-linecap="round" />
              <text x="-22" y="-14" font-size="13" font-weight="900" fill="#0369A1">B</text>
            </g>
            <path d="M 188 220 L 272 220" fill="none" stroke="#0284C7" stroke-width="2" stroke-dasharray="3 3" marker-end="url(#arrow-blue)" />
          </g>

          <!-- A組：右側發球區與發球拋物線 -->
          <g id="svg-group-A" class="svg-role-group">
            <text x="392" y="114" font-size="13" font-weight="900" fill="#15803D">A</text>
            <rect x="424" y="98" width="7" height="24" rx="2" fill="#0284C7" transform="rotate(-22 427 110)" />
            <g transform="translate(460, 110)">
              <circle cx="0" cy="0" r="15" fill="#DCFCE7" stroke="#16A34A" stroke-width="2.5" />
              <circle cx="-5" cy="-3" r="1.8" fill="#15803D" /><circle cx="5" cy="-3" r="1.8" fill="#15803D" />
              <path d="M -5 4 Q 0 9 5 4" fill="none" stroke="#15803D" stroke-width="2" stroke-linecap="round" />
            </g>
            <g transform="translate(498, 110)">
              <circle cx="0" cy="0" r="15" fill="#FFFFFF" stroke="#16A34A" stroke-width="2.5" />
              <circle cx="-5" cy="-3" r="1.8" fill="#16A34A" /><circle cx="5" cy="-3" r="1.8" fill="#16A34A" />
              <path d="M -5 4 Q 0 9 5 4" fill="none" stroke="#16A34A" stroke-width="2" stroke-linecap="round" />
            </g>
            <g transform="translate(536, 110)">
              <circle cx="0" cy="0" r="15" fill="#FFFFFF" stroke="#16A34A" stroke-width="2.5" />
              <circle cx="-5" cy="-3" r="1.8" fill="#16A34A" /><circle cx="5" cy="-3" r="1.8" fill="#16A34A" />
              <path d="M -5 4 Q 0 9 5 4" fill="none" stroke="#16A34A" stroke-width="2" stroke-linecap="round" />
            </g>
            <path d="M 424 102 Q 310 22 192 98" fill="none" stroke="#0F172A" stroke-width="2.5" class="animate-flight" marker-end="url(#arrow-dark)" />

            <text x="392" y="224" font-size="13" font-weight="900" fill="#0369A1">A</text>
            <rect x="424" y="208" width="7" height="24" rx="2" fill="#0284C7" transform="rotate(-22 427 220)" />
            <g transform="translate(460, 220)">
              <circle cx="0" cy="0" r="15" fill="#E0F2FE" stroke="#0284C7" stroke-width="2.5" />
              <circle cx="-5" cy="-3" r="1.8" fill="#0369A1" /><circle cx="5" cy="-3" r="1.8" fill="#0369A1" />
              <path d="M -5 4 Q 0 9 5 4" fill="none" stroke="#0369A1" stroke-width="2" stroke-linecap="round" />
            </g>
            <g transform="translate(498, 220)">
              <circle cx="0" cy="0" r="15" fill="#FFFFFF" stroke="#0284C7" stroke-width="2.5" />
              <circle cx="-5" cy="-3" r="1.8" fill="#0284C7" /><circle cx="5" cy="-3" r="1.8" fill="#0284C7" />
              <path d="M -5 4 Q 0 9 5 4" fill="none" stroke="#0284C7" stroke-width="2" stroke-linecap="round" />
            </g>
            <g transform="translate(536, 220)">
              <circle cx="0" cy="0" r="15" fill="#FFFFFF" stroke="#0284C7" stroke-width="2.5" />
              <circle cx="-5" cy="-3" r="1.8" fill="#0284C7" /><circle cx="5" cy="-3" r="1.8" fill="#0284C7" />
              <path d="M -5 4 Q 0 9 5 4" fill="none" stroke="#0284C7" stroke-width="2" stroke-linecap="round" />
            </g>
            <path d="M 424 212 Q 310 132 192 208" fill="none" stroke="#0F172A" stroke-width="2.5" class="animate-flight" marker-end="url(#arrow-dark)" />
          </g>

          <!-- C組：場邊觀察與記錄員 (橘色笑臉圖示) -->
          <g id="svg-group-C" class="svg-role-group">
            <g transform="translate(145, 28)">
              <circle cx="0" cy="0" r="17" fill="#F59E0B" />
              <circle cx="-5.5" cy="-4" r="2.2" fill="#FFFFFF" /><circle cx="5.5" cy="-4" r="2.2" fill="#FFFFFF" />
              <path d="M -6 4 Q 0 11 6 4" fill="none" stroke="#FFFFFF" stroke-width="2.5" stroke-linecap="round" />
              <rect x="22" y="-11" width="96" height="22" rx="11" fill="#FEF3C7" stroke="#F59E0B" stroke-width="1.5" />
              <text x="70" y="4" font-size="11" font-weight="800" fill="#B45309" text-anchor="middle">C組 觀察與記錄</text>
            </g>
            <g transform="translate(145, 298)">
              <circle cx="0" cy="0" r="17" fill="#F59E0B" />
              <circle cx="-5.5" cy="-4" r="2.2" fill="#FFFFFF" /><circle cx="5.5" cy="-4" r="2.2" fill="#FFFFFF" />
              <path d="M -6 4 Q 0 11 6 4" fill="none" stroke="#FFFFFF" stroke-width="2.5" stroke-linecap="round" />
              <text x="26" y="4" font-size="13" font-weight="900" fill="#B45309">C</text>
            </g>
          </g>
        </svg>
      </div>
    </section>

    <!-- 三步驟輪替流程 -->
    <section class="space-y-3">
      <h2 class="text-base sm:text-lg font-black text-court-deep flex items-center gap-2 px-1">
        <span class="w-2 h-5 bg-court-amber rounded-full"></span>
        三步驟輪替流程
      </h2>

      <!-- Step 1 -->
      <div class="bg-white rounded-3xl p-4 sm:p-5 shadow-sm border border-slate-200/90 flex gap-3.5 items-start">
        <div class="w-9 h-9 rounded-2xl bg-court-navy text-white font-num font-black text-base flex items-center justify-center shrink-0">1</div>
        <div>
          <h3 class="text-base font-black text-court-deep">三組分工，每輪 10 球</h3>
          <p class="text-sm text-slate-600 leading-relaxed mt-1">
            每半場分配 <strong class="text-slate-800">A、B、C 三組</strong>：A 組發球（選擇 3m / 6m / 9m 距離）、B 組接發球至前排目標區、C 組站場邊同步記錄並給予回饋，每輪共計 <strong>10 球</strong>。
          </p>
        </div>
      </div>

      <!-- Step 2 -->
      <div class="bg-white rounded-3xl p-4 sm:p-5 shadow-sm border border-slate-200/90 flex gap-3.5 items-start">
        <div class="w-9 h-9 rounded-2xl bg-emerald-600 text-white font-num font-black text-base flex items-center justify-center shrink-0">2</div>
        <div class="flex-1 space-y-2.5">
          <div>
            <h3 class="text-base font-black text-court-deep">看一球，同步記錄「發球 × 接發球」</h3>
            <p class="text-sm text-slate-600 leading-relaxed mt-1">
              觀察員在每一球同時點選發球與接發球表現：
            </p>
          </div>
          <div class="grid grid-cols-2 gap-2 text-xs">
            <div class="bg-blue-50 border border-blue-200 rounded-2xl p-2.5">
              <div class="font-black text-court-navy mb-1">發球者（A）計分</div>
              <div class="text-slate-700">• 成功過網：<strong>+1 分</strong></div>
              <div class="text-slate-700">• 落入三米線指定區：<strong>+1 分</strong></div>
              <div class="text-blue-700 font-bold mt-1">＋ 位置加分 (10/15/20)</div>
            </div>
            <div class="bg-teal-50 border border-teal-200 rounded-2xl p-2.5">
              <div class="font-black text-teal-900 mb-1">接發球者（B）計分</div>
              <div class="text-slate-700">• 成功接到發球：<strong>+1 分</strong></div>
              <div class="text-slate-700">• 傳入網前舉球區：<strong>+1 分</strong></div>
              <div class="text-teal-700 font-bold mt-1">接起但打出界得 1 分</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Step 3 -->
      <div class="bg-white rounded-3xl p-4 sm:p-5 shadow-sm border border-slate-200/90 flex gap-3.5 items-start">
        <div class="w-9 h-9 rounded-2xl bg-court-amber text-white font-num font-black text-base flex items-center justify-center shrink-0">3</div>
        <div>
          <h3 class="text-base font-black text-court-deep">回饋修正後，互換角色再測一輪</h3>
          <p class="text-sm text-slate-600 leading-relaxed mt-1">
            第一輪結束後進行同儕與自我評量，接著點選<strong>「一鍵互換 A / B 角色資料」</strong>進行第二輪測驗，計算兩人各自總分與雙人合作總分。
          </p>
        </div>
      </div>
    </section>

    <!-- 接發球 4 大動作要點 (Key Points) -->
    <section class="bg-white rounded-3xl p-4 sm:p-5 shadow-sm border border-slate-200/90">
      <h2 class="text-base sm:text-lg font-black text-court-deep flex items-center gap-2 mb-3">
        <i class="fa-solid fa-star text-court-amber"></i>
        接發球 4 大動作要點（Key Points）
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
        <div class="bg-slate-50 border border-slate-200/80 rounded-2xl p-3 flex items-center gap-3">
          <span class="w-7 h-7 rounded-xl bg-court-navy text-white font-num font-black text-xs flex items-center justify-center shrink-0">1</span>
          <span class="text-sm font-bold text-slate-700">屈膝微蹲，手肘放鬆面對前方</span>
        </div>
        <div class="bg-slate-50 border border-slate-200/80 rounded-2xl p-3 flex items-center gap-3">
          <span class="w-7 h-7 rounded-xl bg-court-navy text-white font-num font-black text-xs flex items-center justify-center shrink-0">2</span>
          <span class="text-sm font-bold text-slate-700">依來球高度選用高／低手傳球</span>
        </div>
        <div class="bg-slate-50 border border-slate-200/80 rounded-2xl p-3 flex items-center gap-3">
          <span class="w-7 h-7 rounded-xl bg-court-navy text-white font-num font-black text-xs flex items-center justify-center shrink-0">3</span>
          <span class="text-sm font-bold text-slate-700">傳球時重心放低並朝向目標</span>
        </div>
        <div class="bg-slate-50 border border-slate-200/80 rounded-2xl p-3 flex items-center gap-3">
          <span class="w-7 h-7 rounded-xl bg-court-navy text-white font-num font-black text-xs flex items-center justify-center shrink-0">4</span>
          <span class="text-sm font-bold text-slate-700">穩定控制傳球高度與距離</span>
        </div>
      </div>
    </section>

    <!-- 3 種進階玩法標籤 -->
    <section class="bg-white rounded-3xl p-4 sm:p-5 shadow-sm border border-slate-200/90">
      <div class="flex items-center justify-between mb-3">
        <h2 class="text-base sm:text-lg font-black text-court-deep flex items-center gap-2">
          <i class="fa-solid fa-fire text-rose-500"></i>
          進階修改活動方式
        </h2>
        <span class="text-xs font-bold text-slate-400">點選切換模式</span>
      </div>

      <div class="grid grid-cols-3 gap-1.5 bg-slate-100 p-1.5 rounded-2xl mb-3">
        <button type="button" onclick="selectMode(1)" id="mode-btn-1"
          class="touch-btn py-2.5 px-1.5 rounded-xl text-xs font-black bg-court-navy text-white shadow-sm">
          1. 輪轉積分賽
        </button>
        <button type="button" onclick="selectMode(2)" id="mode-btn-2"
          class="touch-btn py-2.5 px-1.5 rounded-xl text-xs font-bold text-slate-600 hover:bg-white/70">
          2. 雙人站位策略
        </button>
        <button type="button" onclick="selectMode(3)" id="mode-btn-3"
          class="touch-btn py-2.5 px-1.5 rounded-xl text-xs font-bold text-slate-600 hover:bg-white/70">
          3. 接球轉舉球
        </button>
      </div>

      <div id="mode-content-box" class="bg-blue-50/60 border border-blue-200 rounded-2xl p-4 text-sm text-slate-700 leading-relaxed">
        <div class="font-black text-court-navy mb-1 flex items-center gap-1.5">
          <i class="fa-solid fa-trophy text-court-amber"></i>
          <span>小組合作輪轉積分賽</span>
        </div>
        <p>不使用評量表時，可採分組競賽情境：<strong>發完球者移動到接球位置，接完球者移動到發球位置</strong>，計算限定時間內哪一隊累積積分最高！</p>
      </div>
    </section>

    <!-- 底部前往填寫測驗紀錄按鈕 -->
    <div class="pt-1 pb-4">
      <button type="button" onclick="switchMainTab('form')"
        class="touch-btn w-full bg-court-navy hover:bg-blue-800 text-white font-black text-base sm:text-lg py-4 px-6 rounded-2xl shadow-lg flex items-center justify-center gap-2.5 border-b-4 border-court-yellow">
        <span>我懂規則了，前往填寫測驗紀錄</span>
        <i class="fa-solid fa-arrow-right text-court-yellow"></i>
      </button>
    </div>
  </div>

  <!-- ===================================================================== -->
  <!-- 分頁 2：② 測驗評量表單                                                   -->
  <!-- ===================================================================== -->
  <div id="view-form" class="hidden max-w-2xl mx-auto px-4 pt-4 space-y-5">

    <!-- 頂部：Google Sheet 連動狀態與設定折疊面板 -->
    <section class="bg-white rounded-3xl shadow-sm border border-slate-200 overflow-hidden">
      <button type="button" onclick="toggleGasPanel()"
        class="w-full px-4 py-3.5 flex items-center justify-between bg-slate-50 hover:bg-slate-100 transition-colors text-left">
        <div class="flex items-center gap-2.5">
          <span id="panel-gas-dot" class="w-2.5 h-2.5 rounded-full bg-rose-500 animate-pulse"></span>
          <span class="text-sm font-black text-court-deep">Google Sheet 雲端同步設定</span>
          <span id="panel-gas-badge" class="text-[11px] font-bold px-2 py-0.5 rounded-full bg-rose-100 text-rose-700">未設定 URL</span>
        </div>
        <i id="gas-chevron" class="fa-solid fa-chevron-down text-slate-400 transition-transform"></i>
      </button>

      <div id="gas-settings-body" class="hidden p-4 border-t border-slate-200 space-y-3 bg-white">
        <p class="text-xs text-slate-500 leading-relaxed">
          請貼上教師部署的 <strong>Google Apps Script 網頁應用程式網址（Web App URL）</strong>，設定後將自動儲存於此手機瀏覽器中。
        </p>
        <div class="flex flex-col sm:flex-row gap-2">
          <input type="url" id="gas-url-input" placeholder="https://script.google.com/macros/s/AKfycb.../exec"
            class="flex-1 border-2 border-slate-300 focus:border-court-navy rounded-xl px-3 py-2 text-xs sm:text-sm font-mono outline-none" />
          <button type="button" onclick="saveGasUrl()"
            class="touch-btn bg-court-navy hover:bg-blue-800 text-white font-bold px-4 py-2 rounded-xl text-xs sm:text-sm shrink-0">
            <i class="fa-solid fa-check mr-1"></i>儲存網址
          </button>
        </div>

        <!-- 教師端 GAS 程式碼折疊區 -->
        <div class="pt-2 border-t border-slate-100">
          <div class="flex items-center justify-between mb-2">
            <span class="text-xs font-black text-slate-700">📋 教師端 Google Apps Script 接收程式碼</span>
            <button type="button" onclick="copyGasCode()"
              class="touch-btn bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold px-3 py-1.5 rounded-lg flex items-center gap-1.5">
              <i class="fa-regular fa-copy"></i>一鍵複製程式碼
            </button>
          </div>
          <pre id="gas-code-text" class="bg-slate-900 text-emerald-300 text-[11px] p-3 rounded-xl overflow-x-auto font-mono leading-relaxed max-h-44">function doPost(e) {
  var sheet = SpreadsheetApp.getActiveSpreadsheet().getActiveSheet();
  var d = JSON.parse(e.postData.contents);
  
  if (sheet.getLastRow() === 0) {
    sheet.appendRow([
      "提交時間", "班級", "組別", "測驗輪次", "觀察員(C組)",
      "發球者姓名", "發球者學號", "發球者性別", "發球位置", "位置加分", "過網次數", "發球落區次數", "發球總分",
      "接發者姓名", "接發者學號", "接發者性別", "接到次數", "接發落區次數", "接發總分",
      "本輪兩人合作總分", "同儕_動作流暢", "同儕_未做到要點", "同儕_建議", "自評_比之前好", "自評_未做到要點", "自我反思"
    ]);
  }
  
  sheet.appendRow([
    d.timestamp, d.className, d.groupName, d.roundLabel, d.observerName,
    d.server.name, d.server.studentId, d.server.gender, d.server.posLabel, d.server.posBonus, d.server.netCount, d.server.zoneCount, d.server.totalScore,
    d.receiver.name, d.receiver.studentId, d.receiver.gender, d.receiver.hitCount, d.receiver.zoneCount, d.receiver.totalScore,
    d.teamTotalScore, d.feedback.peerFluent, d.feedback.peerMissing, d.feedback.peerNote, d.feedback.selfBetter, d.feedback.selfMissing, d.feedback.selfNote
  ]);
  
  return ContentService.createTextOutput(JSON.stringify({status: "ok"}))
    .setMimeType(ContentService.MimeType.JSON);
}</pre>
          <p class="text-[11px] text-slate-400 mt-1.5">
            部署方式：Google 試算表 → 擴充功能 → Apps Script → 貼上儲存 →「部署」→「新增部署」→ 類型選「網頁應用程式」→ 存取權選「所有人」→ 複製網址貼至上方。
          </p>
        </div>
      </div>
    </section>

    <!-- 基本資料與角色設定區 -->
    <section class="bg-white rounded-3xl shadow-sm border border-slate-200 p-4 sm:p-5 space-y-4">
      <div class="flex items-center justify-between">
        <h2 class="text-base sm:text-lg font-black text-court-deep flex items-center gap-2">
          <span class="w-7 h-7 rounded-xl bg-court-navy text-white font-num text-xs flex items-center justify-center">1</span>
          基本資料與角色分配
        </h2>
        <button type="button" onclick="confirmResetScores()"
          class="touch-btn text-xs font-bold text-slate-500 hover:text-rose-600 bg-slate-100 px-2.5 py-1.5 rounded-xl">
          <i class="fa-solid fa-rotate-left mr-1"></i>清空分數
        </button>
      </div>

      <!-- 班級、組別、觀察員 -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5">
        <div>
          <label class="block text-xs font-bold text-slate-600 mb-1">班級 <span class="text-rose-500">*</span></label>
          <input type="text" id="className" placeholder="如：大一體育A班" oninput="saveDraft()"
            class="w-full bg-slate-50 border border-slate-300 focus:border-court-navy focus:bg-white rounded-xl px-3 py-2.5 text-sm font-bold outline-none" />
        </div>
        <div>
          <label class="block text-xs font-bold text-slate-600 mb-1">組別</label>
          <select id="groupName" onchange="saveDraft()"
            class="w-full bg-slate-50 border border-slate-300 focus:border-court-navy focus:bg-white rounded-xl px-3 py-2.5 text-sm font-bold outline-none">
            <option value="第1組">第1組</option>
            <option value="第2組">第2組</option>
            <option value="第3組">第3組</option>
            <option value="第4組">第4組</option>
            <option value="第5組">第5組</option>
            <option value="第6組">第6組</option>
            <option value="第7組">第7組</option>
            <option value="第8組">第8組</option>
            <option value="第9組">第9組</option>
            <option value="第10組">第10組</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-bold text-slate-600 mb-1">觀察員（C組記錄）</label>
          <input type="text" id="observerName" placeholder="記錄同學姓名" oninput="saveDraft()"
            class="w-full bg-slate-50 border border-slate-300 focus:border-court-navy focus:bg-white rounded-xl px-3 py-2.5 text-sm font-bold outline-none" />
        </div>
      </div>

      <!-- 輪次選擇 + 一鍵互換 A / B 角色資料按鈕 -->
      <div class="bg-slate-100 p-2.5 rounded-2xl flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-2">
        <div class="grid grid-cols-2 gap-1.5 flex-1">
          <button type="button" onclick="setRound('第一輪')" id="round-btn-1"
            class="touch-btn py-2 px-3 rounded-xl text-xs font-black bg-court-navy text-white shadow-sm">
            第一輪
          </button>
          <button type="button" onclick="setRound('第二輪（交換角色）')" id="round-btn-2"
            class="touch-btn py-2 px-3 rounded-xl text-xs font-bold text-slate-600 hover:bg-white/70">
            第二輪（交換角色）
          </button>
        </div>

        <button type="button" onclick="swapPlayers()"
          class="touch-btn bg-court-yellow hover:bg-amber-300 text-court-deep font-black text-xs px-3.5 py-2.5 rounded-xl shadow-sm flex items-center justify-center gap-1.5 shrink-0">
          <i class="fa-solid fa-right-left"></i>
          <span>一鍵互換 A / B 角色資料</span>
        </button>
      </div>

      <!-- 雙人卡片：同學 A（發球者） & 同學 B（接發球者） -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
        <!-- 同學 A：本輪發球者 -->
        <div class="bg-blue-50/70 border-2 border-blue-200 rounded-2xl p-3.5 space-y-2.5">
          <div class="flex items-center justify-between">
            <span class="bg-court-navy text-white text-xs font-black px-2.5 py-1 rounded-full">
              <i class="fa-solid fa-paper-plane text-court-yellow mr-1"></i>同學 A（本輪發球者）
            </span>
          </div>

          <div class="grid grid-cols-12 gap-2">
            <div class="col-span-5">
              <label class="block text-[11px] font-bold text-slate-600 mb-1">姓名 <span class="text-rose-500">*</span></label>
              <input type="text" id="server-name" placeholder="發球者姓名" oninput="syncPlayerLabels(); saveDraft();"
                class="w-full bg-white border border-blue-200 focus:border-court-navy rounded-xl px-2.5 py-2 text-sm font-bold outline-none" />
            </div>
            <div class="col-span-4">
              <label class="block text-[11px] font-bold text-slate-600 mb-1">學號</label>
              <input type="text" id="server-id" placeholder="學號" oninput="saveDraft()"
                class="w-full bg-white border border-blue-200 focus:border-court-navy rounded-xl px-2.5 py-2 text-sm font-num outline-none" />
            </div>
            <div class="col-span-3">
              <label class="block text-[11px] font-bold text-slate-600 mb-1">性別</label>
              <select id="server-gender" onchange="saveDraft()"
                class="w-full bg-white border border-blue-200 focus:border-court-navy rounded-xl px-2 py-2 text-sm font-bold outline-none">
                <option value="男">男</option>
                <option value="女">女</option>
              </select>
            </div>
          </div>

          <!-- 發球位置單選：3m (+10) / 6m (+15) / 9m (+20) -->
          <div>
            <label class="block text-[11px] font-bold text-court-navy mb-1.5">發球位置（基礎起跳分）：</label>
            <div class="grid grid-cols-3 gap-1.5">
              <button type="button" onclick="setServePos(10, '3m')" data-pos="10"
                class="pos-btn touch-btn py-2 px-1 rounded-xl border-2 font-num font-black text-xs text-center bg-court-navy text-white border-court-navy shadow-sm">
                3m (+10)
              </button>
              <button type="button" onclick="setServePos(15, '6m')" data-pos="15"
                class="pos-btn touch-btn py-2 px-1 rounded-xl border-2 font-num font-black text-xs text-center bg-white text-slate-700 border-blue-200">
                6m (+15)
              </button>
              <button type="button" onclick="setServePos(20, '9m')" data-pos="20"
                class="pos-btn touch-btn py-2 px-1 rounded-xl border-2 font-num font-black text-xs text-center bg-white text-slate-700 border-blue-200">
                9m (+20)
              </button>
            </div>
          </div>
        </div>

        <!-- 同學 B：本輪接發球者 -->
        <div class="bg-teal-50/70 border-2 border-teal-200 rounded-2xl p-3.5 space-y-2.5">
          <div class="flex items-center justify-between">
            <span class="bg-teal-700 text-white text-xs font-black px-2.5 py-1 rounded-full">
              <i class="fa-solid fa-hands-holding-circle text-court-yellow mr-1"></i>同學 B（本輪接發球者）
            </span>
          </div>

          <div class="grid grid-cols-12 gap-2">
            <div class="col-span-5">
              <label class="block text-[11px] font-bold text-slate-600 mb-1">姓名 <span class="text-rose-500">*</span></label>
              <input type="text" id="receiver-name" placeholder="接發者姓名" oninput="syncPlayerLabels(); saveDraft();"
                class="w-full bg-white border border-teal-200 focus:border-teal-700 rounded-xl px-2.5 py-2 text-sm font-bold outline-none" />
            </div>
            <div class="col-span-4">
              <label class="block text-[11px] font-bold text-slate-600 mb-1">學號</label>
              <input type="text" id="receiver-id" placeholder="學號" oninput="saveDraft()"
                class="w-full bg-white border border-teal-200 focus:border-teal-700 rounded-xl px-2.5 py-2 text-sm font-num outline-none" />
            </div>
            <div class="col-span-3">
              <label class="block text-[11px] font-bold text-slate-600 mb-1">性別</label>
              <select id="receiver-gender" onchange="saveDraft()"
                class="w-full bg-white border border-teal-200 focus:border-teal-700 rounded-xl px-2 py-2 text-sm font-bold outline-none">
                <option value="男">男</option>
                <option value="女">女</option>
              </select>
            </div>
          </div>

          <div class="bg-white/80 border border-teal-200/80 rounded-xl p-2.5 text-[11px] text-teal-900 leading-snug">
            <strong>接發球目標：</strong>移動至來球落點，將球穩定傳入前排<strong>三米線與球網間指定區域</strong>（每球最高 2 分，共 10 球）。
          </div>
        </div>
      </div>
    </section>

    <!-- 核心「發球 × 接發球」並排計分卡片區 (第 1 球 ～ 第 10 球) -->
    <section class="space-y-3">
      <div class="flex flex-wrap items-center justify-between gap-2 px-1">
        <h2 class="text-base sm:text-lg font-black text-court-deep flex items-center gap-2">
          <span class="w-7 h-7 rounded-xl bg-court-navy text-white font-num text-xs flex items-center justify-center">2</span>
          發球 × 接發球 並排計分（第 1～10 球）
        </h2>
        <div class="flex gap-1.5">
          <button type="button" onclick="quickFillAll('serveNet')"
            class="touch-btn text-[11px] font-bold bg-blue-100 text-court-navy px-2.5 py-1 rounded-lg hover:bg-blue-200">
            發球全過網
          </button>
          <button type="button" onclick="quickFillAll('recvHit')"
            class="touch-btn text-[11px] font-bold bg-teal-100 text-teal-800 px-2.5 py-1 rounded-lg hover:bg-teal-200">
            接發全接到
          </button>
        </div>
      </div>

      <!-- 並排欄位表頭提示 -->
      <div class="grid grid-cols-2 gap-2 px-1 text-center">
        <div class="bg-court-navy text-white py-2 px-2 rounded-2xl text-xs font-black truncate">
          左側：發球者（<span id="header-server-name">同學 A</span>）
        </div>
        <div class="bg-teal-700 text-white py-2 px-2 rounded-2xl text-xs font-black truncate">
          右側：接發球者（<span id="header-receiver-name">同學 B</span>）
        </div>
      </div>

      <!-- 第 1 球 ～ 第 10 球獨立並排卡片容器 -->
      <div id="balls-container" class="space-y-2.5"></div>
    </section>

    <!-- 質性回饋區：同儕回饋 & 自我評量 -->
    <section class="bg-white rounded-3xl shadow-sm border border-slate-200 p-4 sm:p-5 space-y-5">
      <h2 class="text-base sm:text-lg font-black text-court-deep flex items-center gap-2">
        <span class="w-7 h-7 rounded-xl bg-court-navy text-white font-num text-xs flex items-center justify-center">3</span>
        質性回饋與動作檢核
      </h2>

      <!-- 同儕回饋（C 組觀察員填寫） -->
      <div class="bg-slate-50 border border-slate-200 rounded-2xl p-4 space-y-3">
        <div class="text-sm font-black text-court-navy flex items-center gap-1.5">
          <i class="fa-solid fa-eye text-amber-500"></i>
          <span>同儕回饋（C 組觀察員填寫）</span>
        </div>

        <button type="button" onclick="toggleFbBool('peerFluent')" id="btn-peerFluent"
          class="touch-btn w-full py-3 px-4 rounded-xl border-2 text-sm font-black flex items-center justify-between bg-white border-slate-200 text-slate-700">
          <span>動作流暢、判斷準確</span>
          <i class="fa-regular fa-square text-lg"></i>
        </button>

        <div>
          <div class="text-xs font-bold text-slate-600 mb-2">未做到的 Key Point 要點（可多選）：</div>
          <div id="peer-kp-tags" class="grid grid-cols-1 sm:grid-cols-2 gap-2"></div>
        </div>

        <input type="text" id="peer-note" placeholder="觀察員簡短文字建議（選填）..." oninput="saveDraft()"
          class="w-full bg-white border border-slate-300 focus:border-court-navy rounded-xl px-3.5 py-2.5 text-sm outline-none" />
      </div>

      <!-- 自我評量（發球/接發球者填寫） -->
      <div class="bg-amber-50/50 border border-amber-200/80 rounded-2xl p-4 space-y-3">
        <div class="text-sm font-black text-court-deep flex items-center gap-1.5">
          <i class="fa-solid fa-user-check text-teal-600"></i>
          <span>自我評量（受測同學填寫）</span>
        </div>

        <button type="button" onclick="toggleFbBool('selfBetter')" id="btn-selfBetter"
          class="touch-btn w-full py-3 px-4 rounded-xl border-2 text-sm font-black flex items-center justify-between bg-white border-amber-200 text-slate-700">
          <span>比之前的表現更好</span>
          <i class="fa-regular fa-square text-lg"></i>
        </button>

        <div>
          <div class="text-xs font-bold text-slate-600 mb-2">自評未做到的 Key Point 要點（可多選）：</div>
          <div id="self-kp-tags" class="grid grid-cols-1 sm:grid-cols-2 gap-2"></div>
        </div>

        <input type="text" id="self-note" placeholder="自我反思筆記（選填）..." oninput="saveDraft()"
          class="w-full bg-white border border-amber-200 focus:border-court-navy rounded-xl px-3.5 py-2.5 text-sm outline-none" />
      </div>
    </section>

    <!-- 底部功能按鈕：送出同步 & 本機紀錄/CSV -->
    <section class="bg-white rounded-3xl shadow-sm border border-slate-200 p-4 sm:p-5 space-y-4">
      <button type="button" id="submit-btn" onclick="submitAssessment()"
        class="touch-btn w-full bg-court-navy hover:bg-blue-800 text-white font-black text-base sm:text-lg py-4 px-6 rounded-2xl shadow-lg flex items-center justify-center gap-2.5 border-b-4 border-court-yellow">
        <i class="fa-solid fa-cloud-arrow-up text-court-yellow text-xl"></i>
        <span>送出並同步至 Google Sheet</span>
      </button>

      <div class="grid grid-cols-2 gap-2.5">
        <button type="button" onclick="toggleHistoryBox()"
          class="touch-btn bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs sm:text-sm py-3 px-3 rounded-xl flex items-center justify-center gap-1.5">
          <i class="fa-solid fa-clock-rotate-left text-court-navy"></i>
          <span>查看本機暫存 (<span id="history-count-badge" class="font-num">0</span>)</span>
        </button>
        <button type="button" onclick="exportCSV()"
          class="touch-btn bg-emerald-50 hover:bg-emerald-100 text-emerald-800 border border-emerald-200 font-bold text-xs sm:text-sm py-3 px-3 rounded-xl flex items-center justify-center gap-1.5">
          <i class="fa-solid fa-file-csv text-emerald-600"></i>
          <span>匯出 CSV 備份</span>
        </button>
      </div>

      <!-- 本機暫存紀錄展開清單 -->
      <div id="history-box" class="hidden pt-3 border-t border-slate-200 space-y-2.5">
        <div class="flex items-center justify-between">
          <span class="text-xs font-black text-slate-600">本機瀏覽器紀錄備份清單</span>
          <button type="button" onclick="clearHistory()" class="text-xs text-rose-600 font-bold hover:underline">清除全部紀錄</button>
        </div>
        <div id="history-list" class="space-y-2 max-h-60 overflow-y-auto"></div>
      </div>
    </section>

  </div>

  <!-- 即時懸浮計分條 (僅在 ② 測驗評量表單分頁顯示) -->
  <div id="floating-scoreboard" class="hidden fixed bottom-0 inset-x-0 z-40 bg-court-deep/95 backdrop-blur-md text-white border-t-2 border-court-yellow px-3 py-2.5 shadow-2xl">
    <div class="max-w-2xl mx-auto grid grid-cols-11 items-center gap-2 text-center">
      <!-- 發球總分 -->
      <div class="col-span-4 bg-blue-900/70 border border-blue-700/80 rounded-xl py-1 px-2">
        <div class="text-[10px] text-blue-200 font-bold truncate">發球總分 (<span id="float-pos-label">3m+10</span>)</div>
        <div class="text-lg sm:text-xl font-black font-num text-white leading-tight" id="float-serve-score">10</div>
      </div>

      <!-- 本輪兩人合作總分 -->
      <div class="col-span-3 bg-court-yellow text-court-deep rounded-xl py-1 px-1 shadow">
        <div class="text-[10px] font-black tracking-tight">合作總分</div>
        <div class="text-xl sm:text-2xl font-black font-num leading-tight" id="float-team-score">10</div>
      </div>

      <!-- 接發球總分 -->
      <div class="col-span-4 bg-teal-900/70 border border-teal-700/80 rounded-xl py-1 px-2">
        <div class="text-[10px] text-teal-200 font-bold">接發球總分</div>
        <div class="text-lg sm:text-xl font-black font-num text-white leading-tight" id="float-recv-score">0</div>
      </div>
    </div>
  </div>

  <script>
    // =========================================================================
    // 1. 常數與狀態管理
    // =========================================================================
    const KEY_POINTS = [
      '1. 屈膝微蹲、手肘放鬆面對前方',
      '2. 依來球高度選用高/低手傳球',
      '3. 傳球時重心放低並朝向目標',
      '4. 穩定控制傳球高度與距離'
    ];

    const STORAGE_KEYS = {
      GAS_URL: 'volleyball_v3_gas_url',
      DRAFT: 'volleyball_v3_draft',
      HISTORY: 'volleyball_v3_history'
    };

    let formState = {
      roundLabel: '第一輪',
      servePosBonus: 10,
      servePosLabel: '3m',
      // 10 球並排紀錄：{ sNet, sZone, rHit, rZone }
      balls: Array.from({ length: 10 }, () => ({ sNet: 0, sZone: 0, rHit: 0, rZone: 0 })),
      feedback: {
        peerFluent: false,
        peerMissing: [],
        selfBetter: false,
        selfMissing: []
      }
    };

    // =========================================================================
    // 2. 初始化載入
    // =========================================================================
    window.addEventListener('DOMContentLoaded', () => {
      checkGasStatus();
      renderBalls();
      renderKeyPointTags();
      loadDraft();
      recalculateScores();
      renderHistory();
    });

    function showToast(msg, type = 'info') {
      const container = document.getElementById('toast-container');
      const el = document.createElement('div');
      const themes = {
        success: 'bg-emerald-600 text-white border-emerald-300',
        warning: 'bg-court-yellow text-court-deep border-amber-400',
        error: 'bg-rose-600 text-white border-rose-300',
        info: 'bg-court-navy text-white border-blue-400'
      };
      const icons = {
        success: 'fa-circle-check',
        warning: 'fa-triangle-exclamation',
        error: 'fa-circle-exclamation',
        info: 'fa-circle-info'
      };
      el.className = `pointer-events-auto flex items-center gap-2.5 px-4 py-3 rounded-2xl shadow-xl border text-xs sm:text-sm font-black transition-all duration-300 ${themes[type] || themes.info}`;
      el.innerHTML = `<i class="fa-solid ${icons[type]} text-base"></i><span>${msg}</span>`;
      container.appendChild(el);
      setTimeout(() => {
        el.style.opacity = '0';
        el.style.transform = 'translateY(-8px)';
        setTimeout(() => el.remove(), 300);
      }, 3000);
    }

    // =========================================================================
    // 3. 主分頁切換（① 活動操作方式 <-> ② 測驗評量表單）
    // =========================================================================
    function switchMainTab(tab) {
      const guideView = document.getElementById('view-guide');
      const formView = document.getElementById('view-form');
      const tabGuide = document.getElementById('main-tab-guide');
      const tabForm = document.getElementById('main-tab-form');
      const floatingBar = document.getElementById('floating-scoreboard');

      if (tab === 'guide') {
        guideView.classList.remove('hidden');
        formView.classList.add('hidden');
        floatingBar.classList.add('hidden');

        tabGuide.className = 'touch-btn py-2.5 px-3 rounded-xl text-xs sm:text-sm font-black flex items-center justify-center gap-1.5 bg-court-yellow text-court-deep shadow';
        tabForm.className = 'touch-btn py-2.5 px-3 rounded-xl text-xs sm:text-sm font-black flex items-center justify-center gap-1.5 text-blue-100 hover:bg-white/10';
      } else {
        guideView.classList.add('hidden');
        formView.classList.remove('hidden');
        floatingBar.classList.remove('hidden');

        tabForm.className = 'touch-btn py-2.5 px-3 rounded-xl text-xs sm:text-sm font-black flex items-center justify-center gap-1.5 bg-court-yellow text-court-deep shadow';
        tabGuide.className = 'touch-btn py-2.5 px-3 rounded-xl text-xs sm:text-sm font-black flex items-center justify-center gap-1.5 text-blue-100 hover:bg-white/10';
      }
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function openGasFromHeader() {
      switchMainTab('form');
      const body = document.getElementById('gas-settings-body');
      const icon = document.getElementById('gas-chevron');
      body.classList.remove('hidden');
      icon.classList.add('rotate-180');
    }

    // =========================================================================
    // 4. 分頁 1：SVG 角色切換 & 進階玩法標籤
    // =========================================================================
    const ROLE_TEXTS = {
      all: '每半場分 <strong>A、B、C 三組</strong>輪替：A 發球、B 接球進目標區、C 場邊同步記錄與觀察。',
      A: '<strong class="text-emerald-700">【A 組發球任務】</strong>站於右側發球區（可選 3m/6m/9m），每人依序發球過網給對面 B 組。',
      B: '<strong class="text-sky-700">【B 組接發任務】</strong>判斷來球移動接發，將球穩穩傳入前排「目標落地區（舉球位）」，共 10 球。',
      C: '<strong class="text-amber-700">【C 組觀察任務】</strong>站於場邊看一球同時記錄發球與接發球得分，結束後給予同儕回饋。'
    };

    function selectRole(role) {
      ['all', 'A', 'B', 'C'].forEach(r => {
        const btn = document.getElementById(`role-btn-${r}`);
        btn.className = r === role
          ? 'touch-btn py-2 px-1 rounded-xl text-xs font-black bg-court-navy text-white shadow-sm'
          : 'touch-btn py-2 px-1 rounded-xl text-xs font-bold text-slate-600 hover:bg-white/70';
      });
      document.getElementById('role-info-text').innerHTML = ROLE_TEXTS[role];

      const gA = document.getElementById('svg-group-A');
      const gB = document.getElementById('svg-group-B');
      const gC = document.getElementById('svg-group-C');
      const gZ = document.getElementById('svg-target-zones');
      [gA, gB, gC, gZ].forEach(el => el.classList.remove('svg-dimmed', 'svg-highlighted'));

      if (role === 'A') {
        gA.classList.add('svg-highlighted');
        [gB, gC, gZ].forEach(el => el.classList.add('svg-dimmed'));
      } else if (role === 'B') {
        [gB, gZ].forEach(el => el.classList.add('svg-highlighted'));
        [gA, gC].forEach(el => el.classList.add('svg-dimmed'));
      } else if (role === 'C') {
        [gC, gB].forEach(el => el.classList.add('svg-highlighted'));
        [gA, gZ].forEach(el => el.classList.add('svg-dimmed'));
      }
    }

    const MODES_DATA = {
      1: {
        title: '小組合作輪轉積分賽',
        icon: 'fa-trophy text-court-amber',
        desc: '不使用評量表時，可採分組競賽情境：<strong>發完球者移動到接球位置，接完球者移動到發球位置</strong>，計算限定時間內哪一隊累積積分最高！'
      },
      2: {
        title: '對抗式雙人站位策略賽',
        icon: 'fa-chess-board text-court-navy',
        desc: '發球員變成對手，將球發進指定範圍空間內；<strong>兩位接發球員根據站位空間與接球穩定性協調分工</strong>，擬定最佳接發球站位策略以提升成功率。'
      },
      3: {
        title: '接球轉前排舉球補位賽',
        icon: 'fa-people-carry-box text-emerald-600',
        desc: '<strong>有接到發球者移動到前區擋球（扮演舉球員角色）</strong>，未接到接發球者留在原地繼續接發球，另外一人則由場外依序補進輪替。'
      }
    };

    function selectMode(num) {
      [1, 2, 3].forEach(n => {
        const btn = document.getElementById(`mode-btn-${n}`);
        btn.className = n === num
          ? 'touch-btn py-2.5 px-1.5 rounded-xl text-xs font-black bg-court-navy text-white shadow-sm'
          : 'touch-btn py-2.5 px-1.5 rounded-xl text-xs font-bold text-slate-600 hover:bg-white/70';
      });
      const d = MODES_DATA[num];
      document.getElementById('mode-content-box').innerHTML = `
        <div class="font-black text-court-navy mb-1 flex items-center gap-1.5">
          <i class="fa-solid ${d.icon}"></i>
          <span>${d.title}</span>
        </div>
        <p>${d.desc}</p>
      `;
    }

    // =========================================================================
    // 5. Google Sheet 設定管理
    // =========================================================================
    function toggleGasPanel() {
      const body = document.getElementById('gas-settings-body');
      const icon = document.getElementById('gas-chevron');
      body.classList.toggle('hidden');
      icon.classList.toggle('rotate-180');
    }

    function checkGasStatus() {
      const url = localStorage.getItem(STORAGE_KEYS.GAS_URL) || '';
      document.getElementById('gas-url-input').value = url;

      const hDot = document.getElementById('header-gas-dot');
      const hText = document.getElementById('header-gas-text');
      const pDot = document.getElementById('panel-gas-dot');
      const pBadge = document.getElementById('panel-gas-badge');

      if (url && url.startsWith('https://script.google.com/')) {
        hDot.className = 'w-2 h-2 rounded-full bg-emerald-400';
        hText.textContent = '試算表已連線';
        pDot.className = 'w-2.5 h-2.5 rounded-full bg-emerald-500';
        pBadge.className = 'text-[11px] font-bold px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-700';
        pBadge.textContent = '已連線';
      } else {
        hDot.className = 'w-2 h-2 rounded-full bg-rose-400 animate-pulse';
        hText.textContent = '試算表未設定';
        pDot.className = 'w-2.5 h-2.5 rounded-full bg-rose-500 animate-pulse';
        pBadge.className = 'text-[11px] font-bold px-2 py-0.5 rounded-full bg-rose-100 text-rose-700';
        pBadge.textContent = '未設定 URL';
      }
    }

    function saveGasUrl() {
      const url = document.getElementById('gas-url-input').value.trim();
      if (url && !url.startsWith('https://script.google.com/')) {
        showToast('網址格式不正確，請確認以 https://script.google.com/ 開頭', 'error');
        return;
      }
      localStorage.setItem(STORAGE_KEYS.GAS_URL, url);
      checkGasStatus();
      showToast(url ? 'Google Sheet 網址已儲存！' : '已清除試算表網址', 'success');
    }

    function copyGasCode() {
      const code = document.getElementById('gas-code-text').innerText;
      const ta = document.createElement('textarea');
      ta.value = code;
      document.body.appendChild(ta);
      ta.select();
      try {
        document.execCommand('copy');
        showToast('已複製 Google Apps Script 程式碼！', 'success');
      } catch {
        showToast('複製失敗，請手動選取複製', 'error');
      }
      document.body.removeChild(ta);
    }

    // =========================================================================
    // 6. 角色設定、輪次切換與一鍵互換 A / B 角色資料
    // =========================================================================
    function setRound(label) {
      formState.roundLabel = label;
      const b1 = document.getElementById('round-btn-1');
      const b2 = document.getElementById('round-btn-2');
      if (label === '第一輪') {
        b1.className = 'touch-btn py-2 px-3 rounded-xl text-xs font-black bg-court-navy text-white shadow-sm';
        b2.className = 'touch-btn py-2 px-3 rounded-xl text-xs font-bold text-slate-600 hover:bg-white/70';
      } else {
        b2.className = 'touch-btn py-2 px-3 rounded-xl text-xs font-black bg-court-navy text-white shadow-sm';
        b1.className = 'touch-btn py-2 px-3 rounded-xl text-xs font-bold text-slate-600 hover:bg-white/70';
      }
      saveDraft();
    }

    function swapPlayers() {
      const sName = document.getElementById('server-name').value;
      const sId = document.getElementById('server-id').value;
      const sGender = document.getElementById('server-gender').value;

      const rName = document.getElementById('receiver-name').value;
      const rId = document.getElementById('receiver-id').value;
      const rGender = document.getElementById('receiver-gender').value;

      document.getElementById('server-name').value = rName;
      document.getElementById('server-id').value = rId;
      document.getElementById('server-gender').value = rGender;

      document.getElementById('receiver-name').value = sName;
      document.getElementById('receiver-id').value = sId;
      document.getElementById('receiver-gender').value = sGender;

      setRound('第二輪（交換角色）');
      syncPlayerLabels();
      saveDraft();
      showToast('已互換發球者與接發球者資料，並切換至「第二輪」！', 'success');
    }

    function syncPlayerLabels() {
      const sName = document.getElementById('server-name').value.trim() || '同學 A';
      const rName = document.getElementById('receiver-name').value.trim() || '同學 B';
      document.getElementById('header-server-name').textContent = sName;
      document.getElementById('header-receiver-name').textContent = rName;
    }

    function setServePos(bonus, label) {
      formState.servePosBonus = bonus;
      formState.servePosLabel = label;
      document.querySelectorAll('.pos-btn').forEach(btn => {
        if (parseInt(btn.dataset.pos) === bonus) {
          btn.className = 'pos-btn touch-btn py-2 px-1 rounded-xl border-2 font-num font-black text-xs text-center bg-court-navy text-white border-court-navy shadow-sm';
        } else {
          btn.className = 'pos-btn touch-btn py-2 px-1 rounded-xl border-2 font-num font-black text-xs text-center bg-white text-slate-700 border-blue-200';
        }
      });
      document.getElementById('float-pos-label').textContent = `${label}+${bonus}`;
      recalculateScores();
      saveDraft();
    }

    // =========================================================================
    // 7. 渲染「發球 × 接發球」並排計分卡片 (第 1～10 球)
    // =========================================================================
    function renderBalls() {
      const container = document.getElementById('balls-container');
      container.innerHTML = formState.balls.map((b, idx) => {
        const sPts = b.sNet + b.sZone;
        const rPts = b.rHit + b.rZone;
        return `
          <div class="bg-white rounded-2xl border border-slate-200/90 shadow-sm p-3">
            <!-- 球次標題列 -->
            <div class="flex items-center justify-between pb-2 mb-2 border-b border-slate-100">
              <span class="inline-flex items-center gap-1.5 text-xs font-black text-court-deep">
                <span class="w-6 h-6 rounded-lg bg-slate-800 text-court-yellow font-num flex items-center justify-center text-xs">${idx + 1}</span>
                <span>第 ${idx + 1} 球</span>
              </span>
              <div class="flex items-center gap-2 text-[11px] font-num font-bold">
                <span class="text-court-navy">發球 +${sPts}</span>
                <span class="text-slate-300">|</span>
                <span class="text-teal-700">接發 +${rPts}</span>
              </div>
            </div>

            <!-- 左右並排計分按鈕區 -->
            <div class="grid grid-cols-2 gap-2.5">
              <!-- 左側：發球者 (A) -->
              <div class="bg-blue-50/50 rounded-xl p-1.5 grid grid-cols-2 gap-1.5 border border-blue-100">
                <button type="button" onclick="toggleBallPoint(${idx}, 'sNet')"
                  class="touch-btn py-2.5 px-1 rounded-lg border-2 font-bold text-xs flex flex-col items-center justify-center gap-0.5 ${b.sNet ? 'bg-court-navy border-court-navy text-white shadow-sm' : 'bg-white border-slate-200 text-slate-600'}">
                  <span>過網</span>
                  <span class="font-num text-[11px] ${b.sNet ? 'text-court-yellow' : 'text-slate-400'}">+1</span>
                </button>
                <button type="button" onclick="toggleBallPoint(${idx}, 'sZone')"
                  class="touch-btn py-2.5 px-1 rounded-lg border-2 font-bold text-xs flex flex-col items-center justify-center gap-0.5 ${b.sZone ? 'bg-court-yellow border-amber-400 text-court-deep shadow-sm' : 'bg-white border-slate-200 text-slate-600'}">
                  <span>落區</span>
                  <span class="font-num text-[11px] ${b.sZone ? 'text-court-deep font-black' : 'text-slate-400'}">+1</span>
                </button>
              </div>

              <!-- 右側：接發球者 (B) -->
              <div class="bg-teal-50/50 rounded-xl p-1.5 grid grid-cols-2 gap-1.5 border border-teal-100">
                <button type="button" onclick="toggleBallPoint(${idx}, 'rHit')"
                  class="touch-btn py-2.5 px-1 rounded-lg border-2 font-bold text-xs flex flex-col items-center justify-center gap-0.5 ${b.rHit ? 'bg-teal-700 border-teal-700 text-white shadow-sm' : 'bg-white border-slate-200 text-slate-600'}">
                  <span>接到</span>
                  <span class="font-num text-[11px] ${b.rHit ? 'text-court-yellow' : 'text-slate-400'}">+1</span>
                </button>
                <button type="button" onclick="toggleBallPoint(${idx}, 'rZone')"
                  class="touch-btn py-2.5 px-1 rounded-lg border-2 font-bold text-xs flex flex-col items-center justify-center gap-0.5 ${b.rZone ? 'bg-court-yellow border-amber-400 text-court-deep shadow-sm' : 'bg-white border-slate-200 text-slate-600'}">
                  <span>落區</span>
                  <span class="font-num text-[11px] ${b.rZone ? 'text-court-deep font-black' : 'text-slate-400'}">+1</span>
                </button>
              </div>
            </div>
          </div>
        `;
      }).join('');
    }

    // 貼心連動防呆邏輯
    function toggleBallPoint(idx, key) {
      const b = formState.balls[idx];
      b[key] = b[key] ? 0 : 1;

      // 發球側連動：勾選「落區」自動勾選「過網」；取消「過網」自動取消「落區」
      if (key === 'sZone' && b.sZone === 1) b.sNet = 1;
      if (key === 'sNet' && b.sNet === 0) b.sZone = 0;

      // 接發側連動：勾選「落區」自動勾選「接到」；取消「接到」自動取消「落區」
      if (key === 'rZone' && b.rZone === 1) b.rHit = 1;
      if (key === 'rHit' && b.rHit === 0) b.rZone = 0;

      renderBalls();
      recalculateScores();
      saveDraft();
    }

    function quickFillAll(type) {
      formState.balls.forEach(b => {
        if (type === 'serveNet') b.sNet = 1;
        if (type === 'recvHit') b.rHit = 1;
      });
      renderBalls();
      recalculateScores();
      saveDraft();
    }

    function recalculateScores() {
      const sNet = formState.balls.reduce((sum, b) => sum + b.sNet, 0);
      const sZone = formState.balls.reduce((sum, b) => sum + b.sZone, 0);
      const serveTotal = formState.servePosBonus + sNet + sZone;

      const rHit = formState.balls.reduce((sum, b) => sum + b.rHit, 0);
      const rZone = formState.balls.reduce((sum, b) => sum + b.rZone, 0);
      const recvTotal = rHit + rZone;

      const teamTotal = serveTotal + recvTotal;

      document.getElementById('float-serve-score').textContent = serveTotal;
      document.getElementById('float-recv-score').textContent = recvTotal;
      document.getElementById('float-team-score').textContent = teamTotal;
    }

    let resetTimer = null;
    function confirmResetScores() {
      const btn = event.currentTarget;
      if (btn.dataset.confirm !== 'true') {
        btn.dataset.confirm = 'true';
        btn.innerHTML = '<i class="fa-solid fa-triangle-exclamation mr-1"></i>再按一次確認歸零';
        btn.classList.add('bg-rose-100', 'text-rose-700');
        resetTimer = setTimeout(() => {
          btn.dataset.confirm = 'false';
          btn.innerHTML = '<i class="fa-solid fa-rotate-left mr-1"></i>清空分數';
          btn.classList.remove('bg-rose-100', 'text-rose-700');
        }, 3000);
        return;
      }
      clearTimeout(resetTimer);
      btn.dataset.confirm = 'false';
      btn.innerHTML = '<i class="fa-solid fa-rotate-left mr-1"></i>清空分數';
      btn.classList.remove('bg-rose-100', 'text-rose-700');

      formState.balls = Array.from({ length: 10 }, () => ({ sNet: 0, sZone: 0, rHit: 0, rZone: 0 }));
      formState.feedback = { peerFluent: false, peerMissing: [], selfBetter: false, selfMissing: [] };
      document.getElementById('peer-note').value = '';
      document.getElementById('self-note').value = '';

      renderBalls();
      renderKeyPointTags();
      recalculateScores();
      saveDraft();
      showToast('已清空 10 球計分與質性檢核，可開始新一輪記錄！', 'info');
    }

    // =========================================================================
    // 8. 質性回饋標籤渲染與互動
    // =========================================================================
    function renderKeyPointTags() {
      const fb = formState.feedback;

      const btnPeer = document.getElementById('btn-peerFluent');
      btnPeer.className = fb.peerFluent
        ? 'touch-btn w-full py-3 px-4 rounded-xl border-2 text-sm font-black flex items-center justify-between bg-emerald-600 border-emerald-600 text-white shadow-sm'
        : 'touch-btn w-full py-3 px-4 rounded-xl border-2 text-sm font-black flex items-center justify-between bg-white border-slate-200 text-slate-700';
      btnPeer.innerHTML = `<span>動作流暢、判斷準確</span><i class="fa-solid ${fb.peerFluent ? 'fa-square-check' : 'fa-regular fa-square'} text-lg"></i>`;

      const btnSelf = document.getElementById('btn-selfBetter');
      btnSelf.className = fb.selfBetter
        ? 'touch-btn w-full py-3 px-4 rounded-xl border-2 text-sm font-black flex items-center justify-between bg-emerald-600 border-emerald-600 text-white shadow-sm'
        : 'touch-btn w-full py-3 px-4 rounded-xl border-2 text-sm font-black flex items-center justify-between bg-white border-amber-200 text-slate-700';
      btnSelf.innerHTML = `<span>比之前的表現更好</span><i class="fa-solid ${fb.selfBetter ? 'fa-square-check' : 'fa-regular fa-square'} text-lg"></i>`;

      document.getElementById('peer-kp-tags').innerHTML = KEY_POINTS.map(kp => {
        const active = fb.peerMissing.includes(kp);
        return `
          <button type="button" onclick="toggleKpTag('peerMissing', '${kp}')"
            class="touch-btn text-left text-xs font-bold p-2.5 rounded-xl border transition-colors ${active ? 'bg-rose-600 border-rose-600 text-white shadow-sm' : 'bg-white border-slate-300 text-slate-700 hover:bg-slate-100'}">
            ${kp}
          </button>
        `;
      }).join('');

      document.getElementById('self-kp-tags').innerHTML = KEY_POINTS.map(kp => {
        const active = fb.selfMissing.includes(kp);
        return `
          <button type="button" onclick="toggleKpTag('selfMissing', '${kp}')"
            class="touch-btn text-left text-xs font-bold p-2.5 rounded-xl border transition-colors ${active ? 'bg-rose-600 border-rose-600 text-white shadow-sm' : 'bg-white border-amber-200 text-slate-700 hover:bg-amber-100/50'}">
            ${kp}
          </button>
        `;
      }).join('');
    }

    function toggleFbBool(key) {
      formState.feedback[key] = !formState.feedback[key];
      renderKeyPointTags();
      saveDraft();
    }

    function toggleKpTag(listKey, label) {
      const arr = formState.feedback[listKey];
      const idx = arr.indexOf(label);
      if (idx > -1) arr.splice(idx, 1);
      else arr.push(label);
      renderKeyPointTags();
      saveDraft();
    }

    // =========================================================================
    // 9. 草稿暫存與還原
    // =========================================================================
    function saveDraft() {
      const draft = {
        className: document.getElementById('className').value,
        groupName: document.getElementById('groupName').value,
        observerName: document.getElementById('observerName').value,
        serverName: document.getElementById('server-name').value,
        serverId: document.getElementById('server-id').value,
        serverGender: document.getElementById('server-gender').value,
        receiverName: document.getElementById('receiver-name').value,
        receiverId: document.getElementById('receiver-id').value,
        receiverGender: document.getElementById('receiver-gender').value,
        peerNote: document.getElementById('peer-note').value,
        selfNote: document.getElementById('self-note').value,
        formState
      };
      localStorage.setItem(STORAGE_KEYS.DRAFT, JSON.stringify(draft));
    }

    function loadDraft() {
      try {
        const raw = localStorage.getItem(STORAGE_KEYS.DRAFT);
        if (!raw) return;
        const d = JSON.parse(raw);
        if (d.className) document.getElementById('className').value = d.className;
        if (d.groupName) document.getElementById('groupName').value = d.groupName;
        if (d.observerName) document.getElementById('observerName').value = d.observerName;
        if (d.serverName) document.getElementById('server-name').value = d.serverName;
        if (d.serverId) document.getElementById('server-id').value = d.serverId;
        if (d.serverGender) document.getElementById('server-gender').value = d.serverGender;
        if (d.receiverName) document.getElementById('receiver-name').value = d.receiverName;
        if (d.receiverId) document.getElementById('receiver-id').value = d.receiverId;
        if (d.receiverGender) document.getElementById('receiver-gender').value = d.receiverGender;
        if (d.peerNote) document.getElementById('peer-note').value = d.peerNote;
        if (d.selfNote) document.getElementById('self-note').value = d.selfNote;

        if (d.formState) {
          formState = d.formState;
          setRound(formState.roundLabel || '第一輪');
          setServePos(formState.servePosBonus || 10, formState.servePosLabel || '3m');
          renderBalls();
          renderKeyPointTags();
          syncPlayerLabels();
        }
      } catch (e) {
        console.error('載入草稿失敗', e);
      }
    }

    // =========================================================================
    // 10. 送出同步至 Google Sheet 與本機備份 / CSV 匯出
    // =========================================================================
    function buildPayload() {
      const now = new Date();
      const timestamp = `${now.getFullYear()}/${String(now.getMonth() + 1).padStart(2, '0')}/${String(now.getDate()).padStart(2, '0')} ${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}:${String(now.getSeconds()).padStart(2, '0')}`;

      const sNet = formState.balls.reduce((sum, b) => sum + b.sNet, 0);
      const sZone = formState.balls.reduce((sum, b) => sum + b.sZone, 0);
      const sTotal = formState.servePosBonus + sNet + sZone;

      const rHit = formState.balls.reduce((sum, b) => sum + b.rHit, 0);
      const rZone = formState.balls.reduce((sum, b) => sum + b.rZone, 0);
      const rTotal = rHit + rZone;

      return {
        timestamp,
        className: document.getElementById('className').value.trim() || '未填班級',
        groupName: document.getElementById('groupName').value,
        roundLabel: formState.roundLabel,
        observerName: document.getElementById('observerName').value.trim() || '未填觀察員',
        server: {
          name: document.getElementById('server-name').value.trim(),
          studentId: document.getElementById('server-id').value.trim() || '-',
          gender: document.getElementById('server-gender').value,
          posLabel: formState.servePosLabel,
          posBonus: formState.servePosBonus,
          netCount: sNet,
          zoneCount: sZone,
          totalScore: sTotal
        },
        receiver: {
          name: document.getElementById('receiver-name').value.trim(),
          studentId: document.getElementById('receiver-id').value.trim() || '-',
          gender: document.getElementById('receiver-gender').value,
          hitCount: rHit,
          zoneCount: rZone,
          totalScore: rTotal
        },
        teamTotalScore: sTotal + rTotal,
        feedback: {
          peerFluent: formState.feedback.peerFluent ? '是' : '否',
          peerMissing: formState.feedback.peerMissing.join('；') || '無',
          peerNote: document.getElementById('peer-note').value.trim(),
          selfBetter: formState.feedback.selfBetter ? '是' : '否',
          selfMissing: formState.feedback.selfMissing.join('；') || '無',
          selfNote: document.getElementById('self-note').value.trim()
        },
        synced: false
      };
    }

    async function submitAssessment() {
      const sName = document.getElementById('server-name').value.trim();
      const rName = document.getElementById('receiver-name').value.trim();
      if (!sName || !rName) {
        showToast('請先填寫「發球者」與「接發球者」的姓名！', 'warning');
        document.getElementById(!sName ? 'server-name' : 'receiver-name').focus();
        return;
      }

      const payload = buildPayload();
      const gasUrl = localStorage.getItem(STORAGE_KEYS.GAS_URL) || '';
      const btn = document.getElementById('submit-btn');

      btn.disabled = true;
      btn.innerHTML = `<i class="fa-solid fa-spinner fa-spin text-court-yellow text-xl"></i><span>正在送出資料...</span>`;

      if (gasUrl) {
        try {
          await fetch(gasUrl, {
            method: 'POST',
            mode: 'no-cors',
            headers: { 'Content-Type': 'text/plain;charset=utf-8' },
            body: JSON.stringify(payload)
          });
          payload.synced = true;
          showToast('已成功同步至 Google Sheet 並儲存本機紀錄！', 'success');
        } catch (err) {
          payload.synced = false;
          showToast('網路不穩，已先儲存於本機暫存清單，可隨時補傳！', 'warning');
        }
      } else {
        payload.synced = false;
        showToast('尚未設定試算表 URL，資料已存於本機暫存清單（可匯出 CSV）！', 'info');
      }

      const history = getHistory();
      history.unshift(payload);
      localStorage.setItem(STORAGE_KEYS.HISTORY, JSON.stringify(history));
      renderHistory();

      btn.disabled = false;
      btn.innerHTML = `<i class="fa-solid fa-cloud-arrow-up text-court-yellow text-xl"></i><span>送出並同步至 Google Sheet</span>`;
    }

    function getHistory() {
      try {
        return JSON.parse(localStorage.getItem(STORAGE_KEYS.HISTORY)) || [];
      } catch {
        return [];
      }
    }

    function toggleHistoryBox() {
      document.getElementById('history-box').classList.toggle('hidden');
    }

    function renderHistory() {
      const list = getHistory();
      document.getElementById('history-count-badge').textContent = list.length;
      const container = document.getElementById('history-list');

      if (list.length === 0) {
        container.innerHTML = `<div class="text-center py-4 text-xs text-slate-400">尚無本機暫存紀錄</div>`;
        return;
      }

      container.innerHTML = list.map((item, idx) => `
        <div class="bg-slate-50 border border-slate-200 rounded-xl p-3 text-xs flex items-center justify-between gap-2">
          <div>
            <div class="font-black text-court-deep">
              ${item.className} • ${item.groupName} • ${item.roundLabel}
              <span class="ml-1.5 px-2 py-0.5 rounded-full text-[10px] ${item.synced ? 'bg-emerald-100 text-emerald-700' : 'bg-amber-100 text-amber-800'}">
                ${item.synced ? '已同步' : '本機暫存'}
              </span>
            </div>
            <div class="text-slate-600 mt-0.5">
              發球：<strong>${item.server.name}</strong> (${item.server.totalScore}分) ／ 接發：<strong>${item.receiver.name}</strong> (${item.receiver.totalScore}分) ／ 合作總分：<strong class="text-court-navy font-num">${item.teamTotalScore}</strong>
            </div>
            <div class="text-[10px] text-slate-400 font-num mt-0.5">${item.timestamp}</div>
          </div>
          <button type="button" onclick="retrySync(${idx})" class="touch-btn bg-white border border-slate-300 px-2.5 py-1.5 rounded-lg font-bold text-slate-700 shrink-0">
            <i class="fa-solid fa-rotate text-court-navy mr-1"></i>重傳
          </button>
        </div>
      `).join('');
    }

    async function retrySync(idx) {
      const gasUrl = localStorage.getItem(STORAGE_KEYS.GAS_URL) || '';
      if (!gasUrl) {
        showToast('請先展開上方「Google Sheet 雲端同步設定」輸入網址！', 'warning');
        return;
      }
      const list = getHistory();
      const item = list[idx];
      if (!item) return;

      try {
        await fetch(gasUrl, {
          method: 'POST',
          mode: 'no-cors',
          headers: { 'Content-Type': 'text/plain;charset=utf-8' },
          body: JSON.stringify(item)
        });
        item.synced = true;
        localStorage.setItem(STORAGE_KEYS.HISTORY, JSON.stringify(list));
        renderHistory();
        showToast('補傳至 Google Sheet 成功！', 'success');
      } catch {
        showToast('補傳失敗，請檢查網路狀態', 'error');
      }
    }

    function exportCSV() {
      const list = getHistory();
      if (list.length === 0) {
        showToast('目前尚無可匯出的本機紀錄', 'warning');
        return;
      }
      const headers = [
        '提交時間', '班級', '組別', '測驗輪次', '觀察員',
        '發球者姓名', '發球者學號', '發球者性別', '發球位置', '位置加分', '過網次數', '發球落區次數', '發球總分',
        '接發者姓名', '接發者學號', '接發者性別', '接到次數', '接發落區次數', '接發總分',
        '本輪兩人合作總分', '同儕_動作流暢', '同儕_未做到要點', '同儕_建議', '自評_比之前好', '自評_未做到要點', '自我反思'
      ];
      const rows = list.map(d => [
        d.timestamp, d.className, d.groupName, d.roundLabel, d.observerName,
        d.server.name, d.server.studentId, d.server.gender, d.server.posLabel, d.server.posBonus, d.server.netCount, d.server.zoneCount, d.server.totalScore,
        d.receiver.name, d.receiver.studentId, d.receiver.gender, d.receiver.hitCount, d.receiver.zoneCount, d.receiver.totalScore,
        d.teamTotalScore, d.feedback.peerFluent, d.feedback.peerMissing, d.feedback.peerNote, d.feedback.selfBetter, d.feedback.selfMissing, d.feedback.selfNote
      ].map(v => `"${String(v ?? '').replace(/"/g, '""')}"`).join(','));

      const csv = '\uFEFF' + [headers.join(','), ...rows].join('\n');
      const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `排球有球必in評量紀錄_${new Date().toISOString().slice(0, 10)}.csv`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
      showToast('CSV 備份檔已開始下載！', 'success');
    }

    function clearHistory() {
      localStorage.removeItem(STORAGE_KEYS.HISTORY);
      renderHistory();
      showToast('已清除所有本機暫存紀錄', 'info');
    }
  </script>
</body>
</html>
